LLM_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Reddit OAuth app "script" client ID (create at https://www.reddit.com/prefs/apps) — without it, social_scan falls back to public JSON, then RSS (no engagement data)
REDDIT_CLIENT_ID=
# Reddit OAuth app client secret, paired with REDDIT_CLIENT_ID above
REDDIT_CLIENT_SECRET=
# Optional: Reddit account username for password-grant OAuth (higher rate limits than client_credentials); omit to use client_credentials
REDDIT_USERNAME=
# Optional: Reddit account password, paired with REDDIT_USERNAME above
REDDIT_PASSWORD=
